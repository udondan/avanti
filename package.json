{
  "name": "@udondan/avanti",
  "version": "0.8.0",
  "description": "Assemble local files from any source via a declarative YAML spec",
  "bin": {
    "avanti": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cli",
    "sync",
    "files",
    "yaml"
  ],
  "author": {
    "name": "Daniel Schroeder",
    "email": "deemes79@googlemail.com",
    "url": "https://udondan.com/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/udondan"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udondan/avanti.git"
  },
  "dependencies": {
    "chalk": "5.3.0",
    "commander": "12.1.0",
    "comment-json": "^5.0.0",
    "diff": "5.2.2",
    "js-yaml": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/diff": "5.2.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.14.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "tsx": "4.15.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.59.2",
    "vitest": "1.6.0"
  }
}
