{
  "name": "@udondan/avanti",
  "version": "0.19.1",
  "description": "Assemble local files from any source via a declarative YAML spec",
  "bin": {
    "avanti": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cli",
    "sync",
    "files",
    "yaml"
  ],
  "author": {
    "name": "Daniel Schroeder",
    "email": "deemes79@googlemail.com",
    "url": "https://udondan.com/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/udondan"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udondan/avanti.git"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1045.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "comment-json": "5.0.0",
    "diff": "9.0.0",
    "js-yaml": "4.1.1",
    "smol-toml": "1.6.1",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/diff": "8.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.6.2",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.5"
  }
}
