{
  "name": "@udondan/avanti",
  "version": "0.29.0",
  "description": "Assemble local files from any source via a declarative YAML spec",
  "bin": {
    "avanti": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepare": "node -e \"var f=require('fs'),cp=require('child_process');if(!f.existsSync('dist/cli.js')){cp.execSync('bunx tsc -p tsconfig.build.json',{stdio:'inherit'});if(process.platform!=='win32')cp.execSync('chmod +x dist/cli.js')}\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cli",
    "sync",
    "files",
    "yaml"
  ],
  "author": {
    "name": "Daniel Schroeder",
    "email": "deemes79@googlemail.com",
    "url": "https://udondan.com/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/udondan"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udondan/avanti.git"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1126.0",
    "@aws-sdk/client-secrets-manager": "3.1126.0",
    "@aws-sdk/client-ssm": "3.1126.0",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "comment-json": "5.0.0",
    "diff": "9.0.0",
    "ejs": "6.0.1",
    "eta": "4.6.0",
    "handlebars": "4.7.9",
    "js-yaml": "5.4.1",
    "liquidjs": "10.29.0",
    "mustache": "4.2.0",
    "nunjucks": "3.2.4",
    "smol-toml": "1.8.0",
    "tar": "7.5.22",
    "unzipper": "0.12.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/diff": "8.0.0",
    "@types/ejs": "3.1.5",
    "@types/js-yaml": "4.0.9",
    "@types/mustache": "4.2.6",
    "@types/node": "26.4.1",
    "@types/nunjucks": "3.2.6",
    "@types/tar": "7.0.87",
    "@types/unzipper": "0.10.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
