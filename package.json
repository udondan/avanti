{
  "name": "@udondan/avanti",
  "version": "0.2.0",
  "description": "Assemble local files from any source via a declarative YAML spec",
  "bin": {
    "avanti": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cli",
    "sync",
    "files",
    "yaml"
  ],
  "author": "Daniel Schroeder <deemes79@googlemail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "5.3.0",
    "commander": "12.1.0",
    "diff": "5.2.2",
    "js-yaml": "4.1.1"
  },
  "devDependencies": {
    "@types/diff": "5.2.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.14.0",
    "tsx": "4.15.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
