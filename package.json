{
  "name": "@udondan/avanti",
  "version": "0.24.0",
  "description": "Assemble local files from any source via a declarative YAML spec",
  "bin": {
    "avanti": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "prepare": "mise run install-hooks",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cli",
    "sync",
    "files",
    "yaml"
  ],
  "author": {
    "name": "Daniel Schroeder",
    "email": "deemes79@googlemail.com",
    "url": "https://udondan.com/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/udondan"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udondan/avanti.git"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1049.0",
    "@aws-sdk/client-secrets-manager": "3.1049.0",
    "@aws-sdk/client-ssm": "3.1049.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "comment-json": "5.0.0",
    "diff": "9.0.0",
    "ejs": "5.0.2",
    "eta": "4.6.0",
    "handlebars": "4.7.9",
    "js-yaml": "4.1.1",
    "liquidjs": "10.27.0",
    "mustache": "4.2.0",
    "nunjucks": "3.2.4",
    "smol-toml": "1.6.1",
    "tar": "7.5.15",
    "unzipper": "0.12.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/diff": "8.0.0",
    "@types/ejs": "3.1.5",
    "@types/js-yaml": "4.0.9",
    "@types/mustache": "4.2.6",
    "@types/node": "25.9.0",
    "@types/nunjucks": "3.2.6",
    "@types/tar": "7.0.87",
    "@types/unzipper": "0.10.11",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vitest": "4.1.6"
  }
}
